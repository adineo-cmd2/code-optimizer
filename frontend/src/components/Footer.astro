---
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const year = new Date().getFullYear();
const links: { href: string; label: string }[] = [{"href": "/", "label": "Home"}, {"href": "/submit", "label": "Submit"}, {"href": "/analysis", "label": "Analysis"}, {"href": "/diff", "label": "Diff"}, {"href": "/history", "label": "History"}, {"href": "/settings", "label": "Settings"}];
---
<footer class="footer">
  <div class="footer-grid">
    <div>
      <a href={base || '/'} class="brand" style="margin-bottom: 0.9rem">
        <span class="brand-mark"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg></span>
        <span>Code Optimizer</span>
      </a>
      <p class="text-sm leading-relaxed" style="color: var(--ink-soft); max-width: 34rem">
        Static analysis only — submitted code is never executed. Variants are suggestions; review before use. Predicted times are load-aware heuristic estimates, not measured profiles.
      </p>
    </div>
    <div>
      <h4>Explore</h4>
      <ul class="footer-links">
        {links.map((l) => (
          <li>
            <a href={l.href === '/' ? base || '/' : `${base}${l.href}`}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h4>Project</h4>
      <ul class="footer-links">
        <li><a href="https://github.com/adineo-cmd2/code-optimizer" target="_blank" rel="noreferrer">Source on GitHub ↗</a></li>
        <li><a href="https://adineo-cmd2.github.io/code-optimizer/" target="_blank" rel="noreferrer">Live site ↗</a></li>
        <li><span style="font-size: 0.88rem">Local backend · <span class="mono">localhost:8008</span></span></li>
        <li><span style="font-size: 0.88rem">FastAPI + Astro + React</span></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <span>© {year} Code Optimizer · Aditya Yadav</span>
      <span>Deployed on GitHub Pages</span>
    </div>
  </div>
</footer>

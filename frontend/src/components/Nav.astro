---
const links: { href: string; label: string }[] = [{"href": "/", "label": "Home"}, {"href": "/submit", "label": "Submit"}, {"href": "/analysis", "label": "Analysis"}, {"href": "/diff", "label": "Diff"}, {"href": "/history", "label": "History"}, {"href": "/settings", "label": "Settings"}];

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const full = href === '/' ? base || '/' : `${base}${href}`;
  return cur === (full.replace(/\/+$/, '') || '/');
};
---
<header class="nav">
  <div class="nav-inner">
    <a href={base || '/'} class="brand" aria-label="Code Optimizer home">
      <span class="brand-mark">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="6.5" />
          <path d="M12 2.5v4M12 17.5v4M2.5 12h4M17.5 12h4" />
          <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">Code Optimizer</span>
        <span class="brand-sub">measurement lab</span>
      </span>
    </a>

    <div class="nav-right">
      <span class="nav-status" aria-label="Profiler status">
        <span class="status-dot" aria-hidden="true"></span>
        profiler ready
      </span>

      <button id="nav-toggle" class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>

      <nav id="nav-menu" class="nav-menu" aria-label="Main">
        <ul>
          {links.map((l) => (
            <li>
              <a
                href={l.href === '/' ? base || '/' : `${base}${l.href}`}
                data-navlink={l.href}
                class:list={['nav-link', { active: isActive(l.href) }]}
              >
                {l.label}
              </a>
            </li>
          ))}
          <li class="nav-cta-item">
            <a href={`${base}/submit`} class="nav-link nav-cta">Optimize code</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const close = () => {
      menu.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > 930) close();
    });
  }
</script>

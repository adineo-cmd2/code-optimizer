---
const links = [
  { href: '/', label: 'Home' },
  { href: '/submit', label: 'Submit' },
  { href: '/analysis', label: 'Analysis' },
  { href: '/diff', label: 'Diff' },
  { href: '/history', label: 'History' },
  { href: '/settings', label: 'Settings' },
];
---
<nav class="border-b border-editoredge bg-editordark">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3">
    <a href="/" class="font-mono text-lg font-bold text-optgreen">optimizer</a>
    <ul class="flex flex-wrap gap-4">
      {links.map((l) => (
        <li>
          <a href={l.href} class="font-mono text-sm text-zinc-300 hover:text-optgreen">{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>
